# Environment Variables
# COPY FILE INI MENJADI .env DAN ISI DENGAN NILAI YANG SESUAI
# JANGAN COMMIT FILE .env KE REPOSITORY

# =====================
# APPLICATION
# =====================
NODE_ENV=development
PORT=3000
APP_NAME=FoodOrder
APP_URL=http://localhost:3000

# =====================
# DATABASE
# =====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foodorder_db
DB_USER=root
DB_PASSWORD=your_strong_database_password_here

# =====================
# SESSION
# =====================
SESSION_SECRET=your_very_long_random_session_secret_at_least_64_chars_here_change_this
SESSION_MAX_AGE=86400000

# =====================
# BCRYPT
# =====================
BCRYPT_ROUNDS=12

# =====================
# RATE LIMITING
# =====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# =====================
# LOGGING
# =====================
LOG_LEVEL=info
LOG_DIR=./logs
